# Source Database (Remote server to transfer FROM)
EXTERNAL_HOST=source-db.example.com
EXTERNAL_PORT=5432
EXTERNAL_DB_NAME=geodata
EXTERNAL_USER=geoagent
EXTERNAL_PASSWORD=your_source_password

# Target Database (Local server to transfer TO)
LOCAL_HOST=localhost
LOCAL_PORT=5432
LOCAL_DB_NAME=geodata
LOCAL_USER=geoagent
LOCAL_PASSWORD=your_target_password