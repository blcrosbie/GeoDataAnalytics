SOURCE_PORT=5432
SOURCE_DB_NAME=geodata
SOURCE_USER=geoagent
SOURCE_PASSWORD=your_source_password

# Target Database (Local server to transfer TO)
TARGET_HOST=localhost
TARGET_PORT=5432
TARGET_DB_NAME=geodata
TARGET_USER=geoagent
TARGET_PASSWORD=your_target_password