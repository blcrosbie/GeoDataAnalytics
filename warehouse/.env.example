POSTGRES_DB=geodata
POSTGRES_USER=geoadmin
POSTGRES_PASSWORD=change_me
WAREHOUSE_PORT=5434
WAREHOUSE_BIND=127.0.0.1

# Read-only Wasabi key for the lake bucket (pg_duckdb reads s3:// paths with it)
LAKE_S3_KEY_ID=
LAKE_S3_SECRET=
LAKE_S3_REGION=us-central-1
LAKE_S3_ENDPOINT=s3.us-central-1.wasabisys.com
LAKE_BUCKET=your-bucket

DUCKDB_MAX_MEMORY=4GB
DUCKDB_THREADS=4
# Container RAM cap; keep DUCKDB_MAX_MEMORY well below it.
WAREHOUSE_MEM_LIMIT=8g
# TLS cert/key paths on the host (key owned by uid 999, mode 0600). Defaults to ./certs/.
WAREHOUSE_SSL_CERT=./certs/server.crt
WAREHOUSE_SSL_KEY=./certs/server.key
