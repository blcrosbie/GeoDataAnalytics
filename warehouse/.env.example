# ---- Lake writers -------------------------------------------------------------
# Used by scripts/tiger_to_lake.py, scripts/get_reference_data.py,
# load/load_acs_summary_file.py (lake step) and export/export_geoparquet.py sync.
# Every file is staged locally once, then uploaded byte-for-byte to each
# target. The first target is primary (AWS, serves GeoAgent); Wasabi is the
# archive/backup copy and also holds the raw origin/ files.
LAKE_TARGETS=aws,wasabi
LAKE_STAGING=/var/tmp/lake-staging
# Where raw downloads are archived/read (origin/...). Default: wasabi.
ORIGIN_TARGET=wasabi

# AWS S3 (us-east-2). Use a profile (IAM user / SSO) or a static writer key.
LAKE_AWS_BUCKET=your-aws-bucket
LAKE_AWS_REGION=us-east-2
LAKE_AWS_ENDPOINT=
LAKE_AWS_PROFILE=your-publisher-profile
LAKE_AWS_KEY_ID=
LAKE_AWS_SECRET=

# Wasabi (us-central-1). Endpoint is a host, no https://.
LAKE_WASABI_BUCKET=your-wasabi-bucket
LAKE_WASABI_REGION=us-central-1
LAKE_WASABI_ENDPOINT=s3.us-central-1.wasabisys.com
LAKE_WASABI_PROFILE=wasabi
LAKE_WASABI_KEY_ID=
LAKE_WASABI_SECRET=

# ---- RETIRED 2026-11-13: Postgres/pg_duckdb warehouse -------------------------
