# ---- Lake writer ---------------------------------------------------------------
# Used by every *_to_lake.py script in ../scripts and load/load_acs_summary_file.py.
# One bucket: AWS S3, which serves GeoAgent. Only curated (cleaned, transformed)
# files are uploaded; raw downloads stay in LAKE_STAGING and are deleted.
LAKE_TARGETS=aws
LAKE_STAGING=/var/tmp/lake-staging

# AWS S3 (us-east-2). Use a profile (IAM user / SSO) or a static writer key.
LAKE_AWS_BUCKET=your-aws-bucket
LAKE_AWS_REGION=us-east-2
LAKE_AWS_ENDPOINT=
LAKE_AWS_PROFILE=your-publisher-profile
LAKE_AWS_KEY_ID=
LAKE_AWS_SECRET=

