# Environment Variables Example
# Copy this file to .env and update with your values

# Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=geodata_analytics
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here

# Replication Configuration (for production)
REPLICATION_PASSWORD=your_replication_password_here

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
API_KEY=your_api_key_here
SECRET_KEY=your_secret_key_here

# External Services
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
S3_BUCKET_NAME=geodata-analytics-bucket
REDIS_URL=redis://localhost:6379

# MinIO Configuration (for development)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=localhost:9000

# Jupyter Configuration
JUPYTER_TOKEN=geodata
JUPYTER_PORT=8888

# Test Configuration
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/geodata_analytics_test
TEST_TIMEOUT=300
TEST_PARALLEL_WORKERS=4

# Performance Monitoring
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# Security
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem

# Backup Configuration
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_S3_PATH=s3://geodata-backups/