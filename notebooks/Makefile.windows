# Lab stacks on Windows: make -f notebooks/Makefile.windows <target> (run from the repo root)
.PHONY: help postgis-up postgis-down postgis-logs postgis-env \
	jupyter-up jupyter-down jupyter-logs jupyter-env

help:
	@echo "Targets: postgis-env postgis-up postgis-down postgis-logs jupyter-env jupyter-up jupyter-down jupyter-logs"

postgis-env:
	@powershell -NoProfile -Command "Copy-Item notebooks/postgis/.env.example notebooks/postgis/.env"

postgis-up:
	@powershell -NoProfile -Command "Set-Location notebooks/postgis; docker compose up -d"

postgis-down:
	@powershell -NoProfile -Command "Set-Location notebooks/postgis; docker compose down"

postgis-logs:
	@powershell -NoProfile -Command "Set-Location notebooks/postgis; docker compose logs -f"

jupyter-env:
	@powershell -NoProfile -Command "Copy-Item notebooks/jupyter/.env.example notebooks/jupyter/.env"

jupyter-up:
	@powershell -NoProfile -Command "Set-Location notebooks/jupyter; docker compose up -d"

jupyter-down:
	@powershell -NoProfile -Command "Set-Location notebooks/jupyter; docker compose down"

jupyter-logs:
	@powershell -NoProfile -Command "Set-Location notebooks/jupyter; docker compose logs -f"
