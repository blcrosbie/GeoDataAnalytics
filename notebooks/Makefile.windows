.PHONY: help postgis-up postgis-down postgis-logs postgis-env \
	jupyter-up jupyter-down jupyter-logs jupyter-env \
	proxy-up proxy-down proxy-logs proxy-env

help:
	@echo "Targets:"
	@echo "  postgis-env   Copy .env.example to .env for PostGIS"
	@echo "  postgis-up    Start PostGIS stack"
	@echo "  postgis-down  Stop PostGIS stack"
	@echo "  postgis-logs  Tail PostGIS logs"
	@echo "  jupyter-env   Copy .env.example to .env for JupyterLab"
	@echo "  jupyter-up    Start JupyterLab stack"
	@echo "  jupyter-down  Stop JupyterLab stack"
	@echo "  jupyter-logs  Tail JupyterLab logs"
	@echo "  proxy-env     Copy .env.example to .env for Nginx proxy"
	@echo "  proxy-up      Start Nginx proxy + certbot"
	@echo "  proxy-down    Stop Nginx proxy + certbot"
	@echo "  proxy-logs    Tail Nginx logs"

postgis-env:
	@powershell -NoProfile -Command "Copy-Item -Force delab/postgis/.env.example delab/postgis/.env"

postgis-up:
	@powershell -NoProfile -Command "Set-Location delab/postgis; docker compose up -d"

postgis-down:
	@powershell -NoProfile -Command "Set-Location delab/postgis; docker compose down"

postgis-logs:
	@powershell -NoProfile -Command "Set-Location delab/postgis; docker compose logs -f"

jupyter-env:
	@powershell -NoProfile -Command "Copy-Item -Force delab/jupyter/.env.example delab/jupyter/.env"

jupyter-up:
	@powershell -NoProfile -Command "Set-Location delab/jupyter; docker compose up -d"

jupyter-down:
	@powershell -NoProfile -Command "Set-Location delab/jupyter; docker compose down"

jupyter-logs:
	@powershell -NoProfile -Command "Set-Location delab/jupyter; docker compose logs -f"

proxy-env:
	@powershell -NoProfile -Command "Copy-Item -Force delab/proxy/.env.example delab/proxy/.env"

proxy-up:
	@powershell -NoProfile -Command "Set-Location delab/proxy; docker compose up -d"

proxy-down:
	@powershell -NoProfile -Command "Set-Location delab/proxy; docker compose down"

proxy-logs:
	@powershell -NoProfile -Command "Set-Location delab/proxy; docker compose logs -f"
