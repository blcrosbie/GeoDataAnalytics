# Climate Data Store (CDS) Configuration - Weather & Climate Data
CDS_URL=https://cds.climate.copernicus.eu/api/v2
CDS_KEY=your_cds_api_key_here

# Copernicus Data Space Ecosystem (CDSE) Configuration - Earth Observation Data
COPERNICUS_USERNAME=your_copernicus_username
COPERNICUS_PASSWORD=your_copernicus_password
COPERNICUS_CLIENT_ID=your_client_id
COPERNICUS_CLIENT_SECRET=your_client_secret

# S3 storage for the Copernicus fetchers only (the lake scripts use warehouse/.env).
# These fetchers upload every raw download. The lake stores curated data only,
# so don't point them at the lake bucket until they're ported to publish
# transformed output through warehouse/lake_targets.py. The old Wasabi bucket
# they used to target no longer exists.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-2
S3_ENDPOINT_URL=
S3_BUCKET_NAME=

# Rate Limiting Configuration
MAX_CONCURRENT_WORKERS=2
REQUESTS_PER_MINUTE=2000
BANDWIDTH_LIMIT_MBPS=20