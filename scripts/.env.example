# Climate Data Store (CDS) Configuration - Weather & Climate Data
CDS_URL=https://cds.climate.copernicus.eu/api/v2
CDS_KEY=your_cds_api_key_here

# Copernicus Data Space Ecosystem (CDSE) Configuration - Earth Observation Data
COPERNICUS_USERNAME=your_copernicus_username
COPERNICUS_PASSWORD=your_copernicus_password
COPERNICUS_CLIENT_ID=your_client_id
COPERNICUS_CLIENT_SECRET=your_client_secret

# Wasabi S3 Configuration for Data Storage
AWS_ACCESS_KEY_ID=your_wasabi_access_key
AWS_SECRET_ACCESS_KEY=your_wasabi_secret_key
AWS_DEFAULT_REGION=us-east-1
S3_ENDPOINT_URL=https://s3.us-east-1.wasabisys.com
S3_BUCKET_NAME=geoagent-archive

# Rate Limiting Configuration
MAX_CONCURRENT_WORKERS=2
REQUESTS_PER_MINUTE=2000
BANDWIDTH_LIMIT_MBPS=20